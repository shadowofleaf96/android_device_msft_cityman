<!--
  Chromatix names for CameraId 0 mot_imx230.
  Basenames match clark libchromatix_mot_imx230_*.so (no cpp_preview / 3A .so).
  sensor_resolution_index matches libmmcamera_mot_imx230.so out_info:
    0 5344x4016 still, 1 5344x4016 slow, 2 5344x3006 16:9,
    3 4664x2624 4k-class, 4 1336x752 hfr_120, 5 5344x3006 ihdr,
    6 4664x2624 ihdr 4k.
  A3* reuse ISP libs (no mot_imx230_*_3a.so).
-->
<ChromatixConfigurationRoot>
  <CommonChromatixInfo>
    <ChromatixName>
      <ISPCommon>mot_imx230_common</ISPCommon>
      <PostProc>mot_imx230_postproc</PostProc>
    </ChromatixName>
    <ChromatixName special_mode_mask="SCENE_NIGHT">
      <ISPCommon>mot_imx230_common</ISPCommon>
      <ISPPreview>mot_imx230_snapshot_night</ISPPreview>
      <ISPSnapshot>mot_imx230_snapshot_night</ISPSnapshot>
      <CPPSnapshot>mot_imx230_cpp_snapshot_night</CPPSnapshot>
      <PostProc>mot_imx230_postproc</PostProc>
    </ChromatixName>
  </CommonChromatixInfo>
  <ResolutionChromatixInfo>
    <ChromatixName sensor_resolution_index="0">
      <ISPPreview>mot_imx230_snapshot</ISPPreview>
      <ISPSnapshot>mot_imx230_snapshot</ISPSnapshot>
      <ISPVideo>mot_imx230_snapshot</ISPVideo>
      <CPPPreview>mot_imx230_cpp_snapshot</CPPPreview>
      <CPPSnapshot>mot_imx230_cpp_snapshot</CPPSnapshot>
      <CPPVideo>mot_imx230_cpp_snapshot</CPPVideo>
      <CPPLiveshot>mot_imx230_cpp_liveshot</CPPLiveshot>
