// cityman Vulkan 1.0 host-visible map / unmap / remap (system binary).
// Build with: m cityman-vk-map
// Not in PRODUCT_PACKAGES. Do not add this to cityman-vulkan.mk.
// Do not set ro.hwui.use_vulkan.

cc_binary {
    name: "cityman-vk-map",
    srcs: ["vk_map.c"],
    vendor: false,
    proprietary: false,
    compile_multilib: "64",

    shared_libs: [
        "liblog",
        "libvulkan",
    ],

    header_libs: [
        "vulkan_headers",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-DLOG_TAG=\"citymanVkMap\"",
    ],
}
