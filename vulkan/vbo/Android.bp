// Cityman Vulkan 1.0 HOST_VISIBLE VBO + vkCmdDraw (system binary).
// Build with: mka cityman-vk-vbo
// Not in PRODUCT_PACKAGES. Do not add this to cityman-vulkan.mk.
// Do not set ro.hwui.use_vulkan.

cc_binary {
    name: "cityman-vk-vbo",
    srcs: ["main.c"],
    vendor: false,
    proprietary: false,
    compile_multilib: "64",

    shared_libs: [
        "liblog",
        "libvulkan",
    ],

    header_libs: [
        "vulkan_headers",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-DLOG_TAG=\"CitymanVkVbo\"",
    ],
}
