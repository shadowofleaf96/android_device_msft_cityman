// cityman Vulkan 1.0 8x8 texture sample + offscreen readback.
// Command-line native. Not in PRODUCT_PACKAGES. Do not add this to
// cityman-vulkan.mk (other agent). Does not enable HWUI Vulkan.

cc_binary {
    name: "cityman-vk-tex",
    srcs: ["main.c"],
    vendor: false,
    proprietary: false,
    compile_multilib: "64",

    shared_libs: [
        "liblog",
        "libvulkan",
    ],

    header_libs: [
        "vulkan_headers",
    ],

    local_include_dirs: ["."],

    cflags: [
        "-Wall",
        "-Werror",
        "-DLOG_TAG=\"citymanVkTex\"",
    ],
}
