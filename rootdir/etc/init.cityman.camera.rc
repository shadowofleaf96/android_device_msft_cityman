# cityman mm-qcamera-daemon. class main matches AOSP cameraserver.
# persist/camera is the CAF EEPROM dump dir (not on stock WP).
# Never write cityman-cci-scan/scan — slave-id is unknown.

on post-fs
    mkdir /persist/camera 0770 camera camera

on post-fs-data
    mkdir /persist/camera 0770 camera camera
    mkdir /data/misc/camera 0770 camera camera
    mkdir /data/vendor/camera 0770 camera camera

on boot
    start qcamerasvr

# No 'restart cameraserver' on boot_completed (see init.cityman.rc): the
# boot-time cameraserver already has camera 0; the restart only created a
# window with no ICameraService that crashed Snap on an empty camera list.
on property:sys.boot_completed=1
    restart qcamerasvr
    restart cameraserver

service qcamerasvr /vendor/bin/mm-qcamera-daemon
    class main
    user camera
    group camera system inet input graphics
    writepid /dev/cpuset/system-background/tasks

on property:init.svc.media=restarting
    restart qcamerasvr

on property:init.svc.servicemanager=restarting
    restart qcamerasvr
